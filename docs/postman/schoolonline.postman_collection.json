            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "schools"
          ],
          "query": [
            {
              "key": "limit",
              "value": "500"
            },
            {
              "key": "updated_since",
              "value": "{{updated_since}}",
              "disabled": true,
              "description": "Enable only for an incremental scan of this exact filter set."
            },
            {
              "key": "cursor",
              "value": "{{cursor}}",
              "disabled": true,
              "description": "Copy meta.next_cursor from THIS endpoint/filter set. Preserve all other filters."
            }
          ]
        },
        "description": "Requires catalog.read. Every list is paginated. Follow meta.next_cursor until meta.has_more=false. Save meta.watermark only after completing the scan. "
