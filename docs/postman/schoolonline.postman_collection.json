{
  "info": {
    "name": "SchoolOnline SIS API v1 - Student 360",
    "description": "Based on the supplied SchoolOnline API v1 manual, 31 October 2026. Read-only API. No credentials or student records are included. Pagination is manual to prevent sharing cursors/watermarks across resources.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Get access token",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{client_secret}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/oauth/token",
        "description": "Set client_id and client_secret locally in your Postman environment or Vault. Do not export populated secrets."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token issued\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const r = pm.response.json(); pm.environment.set(\"access_token\", r.access_token); pm.environment.set(\"token_expires_at\", String(Date.now() + r.expires_in * 1000)); }"
            ]
          }
        }
      ]
    },
